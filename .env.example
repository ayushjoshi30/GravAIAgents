# ---------------------------------------------------------------------------
# GravAI environment. Copy to .env and adjust. Nothing here is a real secret.
# ---------------------------------------------------------------------------

APP_ENV=local                 # local | dev | staging | prod
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Database --------------------------------------------------------------
# Local default is SQLite so the platform runs with no infrastructure.
# Switch to PostgreSQL to activate row-level security (RLS):
#   DATABASE_URL=postgresql+asyncpg://gravai:gravai@localhost:5432/gravai
DATABASE_URL=sqlite+aiosqlite:///./gravai.db

# --- Redis (rate governor, streams). Optional locally. ---------------------
REDIS_URL=redis://localhost:6379/0

# --- Temporal (durable agent orchestration). Optional locally. -------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=gravai-local

# --- Object storage (documents, audio) -------------------------------------
BLOB_ENDPOINT=http://localhost:9000
BLOB_KEY=minioadmin
BLOB_SECRET=minioadmin
BLOB_BUCKET=gravai-documents

# --- Auth -------------------------------------------------------------------
# Local dev uses HS256 with the shared secret below.
# Production sets OIDC_JWKS_URL and switches to RS256 validation.
# Must be at least 32 bytes (RFC 7518 minimum for HS256).
AUTH_DEV_SECRET=change-me-local-only-and-make-it-32-bytes
OIDC_ISSUER=
OIDC_AUDIENCE=gravai
OIDC_JWKS_URL=

# --- Sarvam AI (the only AI provider) --------------------------------------
# Leave SARVAM_API_KEY empty to force SANDBOX mode (recorded fixtures, no spend).
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_SANDBOX=1
# `sarvam-m` and `sarvam-30b` were withdrawn and now return a hard deprecation
# error. There is no cheaper chat tier — the reasoning and fast roles are the
# same model at the same price, so routing cheap work to a smaller model is not
# an option this provider offers (DECISIONS.md D-012).
SARVAM_MODEL_REASONING=sarvam-105b
SARVAM_MODEL_FAST=sarvam-105b
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_TRANSLATE_MODEL=saaras:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# --- Sarvam Document Intelligence governor ---------------------------------
# 10 req/min observed uniform across plan tiers; extract and digitise share it.
SARVAM_DOCAI_RPM=10
# Unverified whether status polls count against the limit. Default: assume yes.
SARVAM_DOCAI_POLLS_COUNT_TOWARD_LIMIT=true
# All four paths verified against the provider's API reference.
SARVAM_DOCAI_EXTRACT_PATH=/doc-ai/v1/job/extract
SARVAM_DOCAI_DIGITISE_PATH=/doc-ai/v1/job/digitise
SARVAM_DOCAI_STATUS_PATH=/doc-ai/v1/job/{job_id}/status
SARVAM_DOCAI_RESULTS_PATH=/doc-ai/v1/job/{job_id}/results
SARVAM_DOCAI_UPLOAD_PATH=/doc-ai/v1/job/upload
# Hard vendor limit. Longer documents are split client-side before submission;
# a job carrying more than this is rejected outright.
SARVAM_DOCAI_MAX_PAGES_PER_JOB=10
# Poll back-off, applied to BOTH extract and digitise.
SARVAM_DOCAI_POLL_FIRST=0.8
SARVAM_DOCAI_POLL_GROWTH=1.35
SARVAM_DOCAI_POLL_CAP=5.0
SARVAM_DOCAI_POLL_MAX_WALL_CLOCK=180

# --- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=gravai
DD_API_KEY=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Security ---------------------------------------------------------------
KEY_VAULT_URL=
PII_ENCRYPTION_KEY=local-dev-kek-change-me
WEBHOOK_SIGNING_SECRET=local-dev-webhook-secret
